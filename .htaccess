<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block direct access to sensitive files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L,NC]
    RewriteRule ^storage/(framework|logs|private)/ - [F,L,NC]

    # Block root vendor directory while allowing public vendor assets
    RewriteCond %{REQUEST_URI} !^/vendor/space-dynamic/
    RewriteRule ^vendor/ - [F,L,NC]

    # Handle Front Controller for root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^$ public/index.php [L,QSA]

    # Handle all other routes & assets
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
